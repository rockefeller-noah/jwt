{
  "info": {"name": "JWT example", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json", "description": "Start example/server.go with a Redis-backed store. Run requests in order; login and refresh save the token automatically. Demo credentials: demo / demo-password."},
  "variable": [{"key": "base_url", "value": "http://127.0.0.1:8888", "type": "string"}, {"key": "token", "value": "", "type": "string"}],
  "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]},
  "item": [
    {
      "name": "Health",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });", "pm.test(\"JSON status matches HTTP\", function () { pm.expect(pm.response.json().status).to.eql(pm.response.code); });"]}}],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/healthz",
        "auth": {"type": "noauth"}
      }
    },
    {
      "name": "Login",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });", "pm.test(\"JSON status matches HTTP\", function () { pm.expect(pm.response.json().status).to.eql(pm.response.code); });", "if (pm.response.code === 200) {", "  pm.collectionVariables.set(\"token\", pm.response.json().data.token);", "}"]}}],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{base_url}}/login",
        "auth": {"type": "noauth"},
        "body": {"mode": "raw", "raw": "{\"account\":\"demo\",\"password\":\"demo-password\"}", "options": {"raw": {"language": "json"}}}
      }
    },
    {
      "name": "Profile",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });", "pm.test(\"JSON status matches HTTP\", function () { pm.expect(pm.response.json().status).to.eql(pm.response.code); });"]}}],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/profile"
      }
    },
    {
      "name": "Refresh",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });", "pm.test(\"JSON status matches HTTP\", function () { pm.expect(pm.response.json().status).to.eql(pm.response.code); });", "if (pm.response.code === 200) {", "  pm.collectionVariables.set(\"token\", pm.response.json().data.token);", "}"]}}],
      "request": {
        "method": "PUT",
        "header": [],
        "url": "{{base_url}}/refresh"
      }
    },
    {
      "name": "Profile with refreshed token",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });", "pm.test(\"JSON status matches HTTP\", function () { pm.expect(pm.response.json().status).to.eql(pm.response.code); });"]}}],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/profile"
      }
    },
    {
      "name": "Logout",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });", "pm.test(\"JSON status matches HTTP\", function () { pm.expect(pm.response.json().status).to.eql(pm.response.code); });"]}}],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/logout"
      }
    },
    {
      "name": "Profile after logout (expect 401)",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });", "pm.test(\"JSON status matches HTTP\", function () { pm.expect(pm.response.json().status).to.eql(pm.response.code); });"]}}],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/profile"
      }
    }
  ]
}
